@@ -412,6 +412,149 @@ class VmNodesController
         return ApiResponse::success(['vm_node' => $safeNode], 'VM node created successfully', 201);
     }
 
+    /**
+     * local-feather-v2: create a local KVM/libvirt VDS node from just a name.
+     *
+     * The panel asks the local node agent (running on the host, see setup.sh) to
+     * register a new node and hand back API credentials, then stores them as a
+     * regular VM node. No Proxmox host, FQDN or token has to be entered by hand.
+     */
+    public function createLocal(Request $request): Response
+    {
+        $admin = $request->attributes->get('user');
+        $data = json_decode($request->getContent(), true);
+        if (json_last_error() !== JSON_ERROR_NONE || !is_array($data)) {
+            return ApiResponse::error('Invalid JSON in request body', 'INVALID_JSON', 400);
+        }
+
+        $name = isset($data['name']) && is_string($data['name']) ? trim($data['name']) : '';
+        if ($name === '') {
+            return ApiResponse::error('Name is required', 'MISSING_REQUIRED_FIELDS', 400);
+        }
+        if (strlen($name) > 255) {
+            return ApiResponse::error('Name must be at most 255 characters', 'INVALID_DATA_LENGTH', 400);
+        }
+
+        $agentUrl = rtrim((string) (getenv('LOCAL_NODE_AGENT_URL') ?: 'http://host.docker.internal:8007'), '/');
+        $agentToken = (string) (getenv('LOCAL_NODE_AGENT_ADMIN_TOKEN') ?: '');
+        $agent = parse_url($agentUrl);
+        if ($agentToken === '' || !is_array($agent) || empty($agent['host'])) {
+            return ApiResponse::error('Local node agent is not configured. Run setup.sh from local-feather-v2 first.', 'LOCAL_NODE_NOT_CONFIGURED', 503);
+        }
+
+        foreach (VmNode::getAllVmNodes() as $existing) {
+            if (strcasecmp((string) ($existing['name'] ?? ''), $name) === 0) {
+                return ApiResponse::error('A VDS node with this name already exists', 'DUPLICATE_NAME', 409);
+            }
+        }
+
+        // Re-use (or create once) a VPS/VDS location called "Local".
+        $locationId = null;
+        foreach (Location::getAll('Local', 100, 0, 'vps') as $loc) {
+            if (strcasecmp((string) ($loc['name'] ?? ''), 'Local') === 0) {
+                $locationId = (int) $loc['id'];
+                break;
+            }
+        }
+        if ($locationId === null) {
+            $created = Location::create([
+                'name' => 'Local',
+                'description' => 'Local KVM/libvirt VDS nodes (created by local-feather-v2)',
+                'type' => 'vps',
+            ]);
+            if (!$created) {
+                return ApiResponse::error('Failed to create the Local location', 'LOCATION_CREATE_FAILED', 500);
+            }
+            $locationId = (int) $created;
+        }
+
+        $http = new \GuzzleHttp\Client(['timeout' => 60, 'http_errors' => false]);
+        $agentHeaders = ['Authorization' => 'Bearer ' . $agentToken, 'Accept' => 'application/json'];
+
+        try {
+            $resp = $http->post($agentUrl . '/local/nodes', ['headers' => $agentHeaders, 'json' => ['name' => $name]]);
+        } catch (\Throwable $e) {
+            App::getInstance(true)->getLogger()->error('Local node agent unreachable: ' . $e->getMessage());
+
+            return ApiResponse::error('Local node agent is not reachable. Is the local-feather-agent service running?', 'LOCAL_NODE_AGENT_UNREACHABLE', 502);
+        }
+
+        $agentBody = json_decode((string) $resp->getBody(), true);
+        $agentData = is_array($agentBody) ? ($agentBody['data'] ?? null) : null;
+        if (!in_array($resp->getStatusCode(), [200, 201], true) || !is_array($agentData)
+            || empty($agentData['token_id']) || empty($agentData['secret'])) {
+            $reason = is_array($agentBody) && isset($agentBody['error']) ? (string) $agentBody['error'] : 'HTTP ' . $resp->getStatusCode();
+            App::getInstance(true)->getLogger()->error('Local node agent refused node creation: ' . $reason);
+
+            return ApiResponse::error('Local node agent error: ' . $reason, 'LOCAL_NODE_AGENT_FAILED', 502);
+        }
+
+        $vmNodeId = VmNode::createVmNode([
+            'name' => $name,
+            'description' => 'Local KVM/libvirt node',
+            'location_id' => $locationId,
+            'fqdn' => (string) $agent['host'],
+            'scheme' => ($agent['scheme'] ?? 'http') === 'https' ? 'https' : 'http',
+            'port' => (int) ($agent['port'] ?? 8007),
+            'user' => (string) ($agentData['user'] ?? 'root@pam'),
+            'token_id' => (string) $agentData['token_id'],
+            'secret' => (string) $agentData['secret'],
+            'tls_no_verify' => 'true',
+            'timeout' => 120,
+        ]);
+
+        if (!$vmNodeId) {
+            // Do not leave an orphaned node behind in the agent.
+            try {
+                $http->delete($agentUrl . '/local/nodes/' . rawurlencode((string) ($agentData['node'] ?? $name)), ['headers' => $agentHeaders]);
+            } catch (\Throwable $e) {
+                App::getInstance(true)->getLogger()->error('Failed to roll back local node in agent: ' . $e->getMessage());
+            }
+
+            return ApiResponse::error('Failed to create VM node', 'VM_NODE_CREATE_FAILED', 400);
+        }
+
+        // Register the cloud-image templates the agent offers so the node is usable right away.
+        foreach (is_array($agentData['templates'] ?? null) ? $agentData['templates'] : [] as $tpl) {
+            if (!is_array($tpl) || !isset($tpl['vmid'], $tpl['name'])) {
+                continue;
+            }
+            try {
+                VmTemplate::create([
+                    'name' => (string) $tpl['name'],
+                    'description' => 'Local cloud image template',
+                    'guest_type' => 'qemu',
+                    'storage' => 'local',
+                    'template_file' => (string) (int) $tpl['vmid'],
+                    'vm_node_id' => (int) $vmNodeId,
+                    'is_active' => 'true',
+                ]);
+            } catch (\Throwable $e) {
+                App::getInstance(true)->getLogger()->error('Failed to register local template: ' . $e->getMessage());
+            }
+        }
+
+        $vmNode = VmNode::getVmNodeById($vmNodeId);
+
+        Activity::createActivity([
+            'user_uuid' => $admin['uuid'] ?? null,
+            'name' => 'create_vm_node',
+            'context' => 'Created local VM node: ' . ($vmNode['name'] ?? $name),
+            'ip_address' => CloudFlareRealIP::getRealIP(),
+        ]);
+
+        $safeNode = VmNode::sanitizeForAdminResponse($vmNode ?? []);
+
+        self::emitVdsEvent(VdsNodeEvent::onVdsNodeCreated(), [
+            'user_uuid' => $admin['uuid'] ?? null,
+            'vm_node_id' => (int) $vmNodeId,
+            'vm_node' => $safeNode,
+            'context' => ['source' => 'admin-local'],
+        ]);
+
+        return ApiResponse::success(['vm_node' => $safeNode], 'Local VM node created successfully', 201);
+    }
+
